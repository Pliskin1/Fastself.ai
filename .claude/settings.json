{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm format)",
      "Bash(pnpm format *)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:core)",
      "Bash(pnpm test:core *)",
      "Bash(pnpm test:app)",
      "Bash(pnpm test:app *)",
      "Bash(pnpm build:edge)",
      "Bash(adb devices)",
      "Bash(adb reverse *)",
      "Bash(pnpm --filter * run *)",
      "Bash(pnpm --filter * test *)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx jest *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(npx expo config *)",
      "Bash(npx expo-doctor)",
      "Bash(npx expo-doctor *)",
      "Bash(npx expo export *)",
      "Bash(supabase start)",
      "Bash(supabase stop)",
      "Bash(supabase status)",
      "Bash(supabase db reset)",
      "Bash(supabase db lint *)",
      "Bash(supabase test db)",
      "Bash(supabase test db *)",
      "Bash(supabase migration new *)",
      "Bash(supabase migration list *)",
      "Bash(supabase gen types *)",
      "Bash(supabase functions serve *)",
      "Bash(deno test *)",
      "Bash(deno check *)",
      "Bash(deno lint *)",
      "Bash(deno fmt *)",
      "Bash(maestro test *)",
      "Bash(maestro hierarchy)",
      "Bash(xcrun simctl list *)",
      "Bash(xcrun simctl boot *)",
      "Bash(xcrun simctl openurl *)",
      "Bash(xcrun simctl io * screenshot *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git rev-parse *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(node .claude/hooks/*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(npx expo install *)",
      "Bash(npx expo prebuild *)",
      "Bash(eas *)",
      "Bash(supabase link *)",
      "Bash(supabase db push *)",
      "Bash(supabase functions deploy *)",
      "Bash(supabase secrets *)",
      "Bash(xcrun simctl erase *)",
      "Bash(pnpm ios)",
      "Bash(pnpm android)",
      "Bash(npx expo run:ios *)",
      "Bash(npx expo run:android *)",
      "Bash(npx expo start *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.development.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.production.local)",
      "Read(./**/*.p8)",
      "Read(./**/credentials.json)",
      "Read(./supabase/.temp/**)",
      "Bash(eas submit)",
      "Bash(eas submit *)",
      "Bash(supabase db reset --linked)",
      "Bash(supabase db reset --linked *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(printenv)",
      "Bash(printenv *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-bash.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  }
}
