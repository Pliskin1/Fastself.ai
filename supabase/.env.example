# Copy to supabase/.env.local for `supabase functions serve --env-file supabase/.env.local` (never commit).
# For dev and prod use `supabase secrets set NAME=value --project-ref <ref>` instead.
AI_PROVIDER=mock            # mock | cloudflare (prod) | anthropic
CF_ACCOUNT_ID=              # Cloudflare dashboard → Workers AI → Use REST API
CF_API_TOKEN=               # Workers AI Read + Edit
CF_AI_MODEL=                # optional; default @cf/meta/llama-3.3-70b-instruct-fp8-fast
ANTHROPIC_API_KEY=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=ai.fastself.app
APPLE_PRIVATE_KEY=
HASH_SALT=
